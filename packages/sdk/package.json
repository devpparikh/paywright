{
  "name": "@paywright/sdk",
  "version": "1.0.0",
  "description": "TypeScript client SDK for the Paywright payment service",
  "author": "Dev Parikh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devpparikh/paywright.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "axios",
