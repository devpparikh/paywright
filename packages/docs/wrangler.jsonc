{
	"name": "paywright-docs",
	"compatibility_date": "2026-10-01",
	// Static site only — no Worker script; Cloudflare serves dist/ directly
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	// Deploy creates the DNS record and certificate for this hostname
	"routes": [{ "pattern": "docs.paywright.dev-parikh.com", "custom_domain": true }]
}
